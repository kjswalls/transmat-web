PORT=8787
TRANSMAT_TOKEN=dev-token-change-me
DATA_DIR=./.data
STORAGE_DRIVER=local
PUSH_DRIVER=console
# Rate limiting is ON unless you turn it off. Per client IP, since one shared
# bearer token means there is no per-user anything to limit against.
# RATE_LIMIT=false
# Only set this when something in front of the server actually sets
# X-Forwarded-For. Otherwise callers pick their own rate-limit bucket.
# TRUST_PROXY=true
# The local storage driver builds every signed download URL from this. The
# default (http://localhost:$PORT) is right for dev and wrong for anything a
# phone has to reach.
PUBLIC_BASE_URL=http://localhost:8787
# Signs the /blob/:key URLs. Defaults to TRANSMAT_TOKEN; set it separately if
# you ever rotate the bearer token without invalidating live download links.
# BLOB_SIGNING_SECRET=
# --- fill these in the morning ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=transmat
# APNS_KEY_PATH=./secrets/AuthKey_XXXXXXXX.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.kjswalls.transmat
# APNS_ENV=sandbox
